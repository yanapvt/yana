NODE_ENV=development
PORT=3000
FORM_PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_PLACES_API_KEY=
HOTEL_GOOGLE_PLACES_ENABLED=true

# Local SLTDA registered-accommodation verification gate.
SLTDA_REGISTRY_ENABLED=false
SLTDA_REQUIRE_VERIFIED_HOTELS=true
SLTDA_MATCH_MIN_CONFIDENCE=0.80

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yana_ogo
POSTGRES_USER=yana
POSTGRES_PASSWORD=yana_password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

LLM_PROVIDER=openai
LLM_API_KEY=dev_api_key
LLM_MODEL=gpt-4
LLM_BASE_URL=https://api.openai.com/v1
LLM_CONFIDENCE_THRESHOLD=0.85
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=
VOICE_NOTE_MAX_MB=10

TWILIO_ACCOUNT_SID=dev_account_sid
TWILIO_AUTH_TOKEN=dev_auth_token
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=dev_webhook_secret
# Set this to the exact webhook URL configured in Twilio when running behind ngrok or a proxy.
# TWILIO_WEBHOOK_PUBLIC_URL=https://your-subdomain.ngrok-free.dev/webhook/whatsapp
# Development-only fallback when testing locally without real Twilio credentials:
# TWILIO_SIGNATURE_BYPASS=true

# WhatsApp provider bridge. Keep "twilio" for the official Twilio sandbox/API.
# Use "openwa" when routing outbound replies through a self-hosted OpenWA server.
# Use "meta" for direct official Meta WhatsApp Cloud API.
WHATSAPP_PROVIDER=twilio
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_WEBHOOK_SECRET=
# Configure OpenWA webhooks to call:
# https://your-public-yana-url/webhook/openwa

# Direct Meta WhatsApp Cloud API provider.
# Configure Meta webhooks to call:
# https://your-public-yana-url/webhook/meta
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_API_VERSION=v20.0
META_WHATSAPP_MEDIA_PROXY_SECRET=

TRANSLATION_DEFAULT_LANGUAGE=en
TRANSLATION_CONFIDENCE_THRESHOLD=0.7
TTS_ENABLED=false
FEATURE_TTS_ENABLED=false
FEATURE_PROACTIVE_MESSAGING_ENABLED=false
FEATURE_VENDOR_CMS_ENABLED=false

SESSION_TTL_SECONDS=3600
TOOL_RETRY_MAX_ATTEMPTS=3
PAYMENT_TIMEOUT_MINUTES=15
BOOKING_HOLD_TIMEOUT_MINUTES=10

# Multi-aggregator hotel inventory. Disabled by default until at least one
# supplier adapter has been configured and verified. Never commit real keys.
HOTEL_SUPPLIER_ORCHESTRATION_ENABLED=false
# Internal operational logs only. Never expose supplier IDs or offer tokens to customers.
HOTEL_SUPPLIER_ATTRIBUTION_LOG_ENABLED=false
HOTEL_SUPPLIER_TIMEOUT_MS=15000
HOTEL_SUPPLIER_MAX_RETRIES=2
HOTEL_SUPPLIER_RETRY_DELAY_MS=500
HOTEL_SUPPLIER_CIRCUIT_FAILURE_THRESHOLD=3
HOTEL_SUPPLIER_CIRCUIT_COOLDOWN_MS=60000
HOTEL_SUPPLIER_RATE_LIMIT_PER_MINUTE=60

# LiteAPI / Nuitee
LITEAPI_ENABLED=false
LITEAPI_PRIORITY=1
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_API_KEY=

# Hotelbeds / HBX
HOTELBEDS_ENABLED=false
HOTELBEDS_PRIORITY=2
HOTELBEDS_BASE_URL=
HOTELBEDS_API_KEY=
HOTELBEDS_API_SECRET=

# WebBeds
WEBBEDS_ENABLED=false
WEBBEDS_PRIORITY=3
WEBBEDS_BASE_URL=
WEBBEDS_API_KEY=
WEBBEDS_API_SECRET=

# Booking.com Demand API (requires approved partner access)
BOOKING_DEMAND_ENABLED=false
BOOKING_DEMAND_PRIORITY=4
BOOKING_DEMAND_BASE_URL=
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_AFFILIATE_ID=

# Agoda Demand/B2B (requires approved partner access)
AGODA_ENABLED=false
AGODA_PRIORITY=5
AGODA_BASE_URL=
AGODA_API_KEY=
AGODA_SITE_ID=

# YANA direct hotel/PMS inventory
YANA_DIRECT_ENABLED=false
YANA_DIRECT_PRIORITY=6
YANA_DIRECT_BASE_URL=
YANA_DIRECT_API_KEY=

# Any global policy can be overridden per supplier, for example:
# LITEAPI_TIMEOUT_MS=10000
# LITEAPI_MAX_RETRIES=1
# LITEAPI_RETRY_DELAY_MS=250
# LITEAPI_CIRCUIT_FAILURE_THRESHOLD=3
# LITEAPI_CIRCUIT_COOLDOWN_MS=60000
# LITEAPI_RATE_LIMIT_PER_MINUTE=120
