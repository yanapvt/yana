# Environment
NODE_ENV=development
PORT=3000

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WEBHOOK_SECRET=

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yana_ogo
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_CONFIDENCE_THRESHOLD=0.85

# Translation Service
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
TRANSLATION_DEFAULT_LANGUAGE=en
TRANSLATION_CONFIDENCE_THRESHOLD=0.7

# Text-to-Speech
TTS_PROVIDER=
TTS_API_KEY=
TTS_ENABLED=false

# Nango Integration
NANGO_SECRET_KEY=
NANGO_PUBLIC_KEY=
NANGO_HOST=https://api.nango.dev

# Feature Flags
FEATURE_TTS_ENABLED=false
FEATURE_PROACTIVE_MESSAGING_ENABLED=false
FEATURE_VENDOR_CMS_ENABLED=false

# Operational Settings
SESSION_TTL_SECONDS=3600
TOOL_RETRY_MAX_ATTEMPTS=3
PAYMENT_TIMEOUT_MINUTES=15
BOOKING_HOLD_TIMEOUT_MINUTES=10
