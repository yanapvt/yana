{
  "name": "yana-ogo-platform",
  "version": "0.1.0",
  "description": "WhatsApp-first AI orchestration platform for tourism and real-world service domains",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "deploy:gcp:run": "gcloud run deploy yana-ogo-platform --source . --region us-central1",
    "deploy:gcp:appengine": "gcloud app deploy app.yaml",
    "deploy:gcp:gke": "kubectl apply -f k8s-gcp-deployment.yaml",
    "build:gcp": "gcloud builds submit --config cloudbuild.yaml"
  },
  "keywords": [
    "whatsapp",
    "ai",
    "orchestration",
    "tourism",
    "booking"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/logging": "^9.5.3",
    "@google-cloud/secret-manager": "^5.0.1",
    "@google-cloud/text-to-speech": "^5.0.1",
    "@google-cloud/trace-agent": "^7.1.0",
    "@google-cloud/translate": "^9.3.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "pg": "^8.11.3",
    "redis": "^4.7.1",
    "twilio": "^5.5.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "prettier": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
