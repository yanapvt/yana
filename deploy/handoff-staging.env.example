# Non-secret staging manifest. Inject URLs, identifiers, and all secret values
# from the deployment platform; do not copy this file into production as .env.
NODE_ENV=staging
HUMAN_HANDOFF_ENABLED=false
HUMAN_HANDOFF_FALLBACK_QUEUE_ENABLED=true
HUMAN_HANDOFF_QUEUE_PROCESSING_ENABLED=false
HUMAN_HANDOFF_STAFF_PUBLICATION_ENABLED=false
HUMAN_HANDOFF_ALERT_DELIVERY_ENABLED=false
HUMAN_HANDOFF_DASHBOARD_ENABLED=false
HUMAN_HANDOFF_DASHBOARD_SESSION_STORE=postgres
HUMAN_HANDOFF_DASHBOARD_LOCAL_TOKEN_ENABLED=false
HUMAN_HANDOFF_OIDC_ENABLED=false
HUMAN_HANDOFF_NATIVE_GROUP_ENABLED=false
HUMAN_HANDOFF_STAGING_DRILL_ENABLED=false

# Required secret-manager bindings before enabling the corresponding feature:
# DATABASE_URL
# REDIS_URL
# HUMAN_HANDOFF_OPERATOR_IDENTITIES_JSON (local fallback only)
# HUMAN_HANDOFF_DASHBOARD_SESSION_KEYS_JSON
# HUMAN_HANDOFF_DASHBOARD_ACTIVE_KEY_ID
# HUMAN_HANDOFF_STAFF_PUBLICATION_AUTH_TOKEN
# HUMAN_HANDOFF_ALERT_DELIVERY_AUTH_TOKEN

# Required approved OIDC values before HUMAN_HANDOFF_OIDC_ENABLED=true:
HUMAN_HANDOFF_OIDC_ISSUER=
HUMAN_HANDOFF_OIDC_CLIENT_ID=
HUMAN_HANDOFF_OIDC_REDIRECT_URI=
HUMAN_HANDOFF_OIDC_AUTHORIZATION_ENDPOINT=
HUMAN_HANDOFF_OIDC_TOKEN_ENDPOINT=
HUMAN_HANDOFF_OIDC_ROLE_CLAIM=roles
HUMAN_HANDOFF_OIDC_ROLE_MAPPING_JSON={}
